#!/usr/bin/env bash

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export APP_ROOT="$(cd "$CONFIG_DIR/.." && pwd)"

# repo
export GIT_REPO_URL="git@github.com:your-org/legal_api.git"
export GIT_BRANCH="main"
# export GIT_COMMIT_SHA=""

# backend
export COMPOSE_PROJECT_NAME="legal-local"
export SERVER_HOST="0.0.0.0"
export BACKEND_PORT="19088"
export API_BIND="127.0.0.1"
export JWT_SECRET="local-development-secret"
export ADMIN_BOOTSTRAP_PASSWORD="admin"
export POSTGRES_IMAGE="postgres:15"
export POSTGRES_USER="legal"
export POSTGRES_PASSWORD="legal"
export POSTGRES_DB="legal_rag"
export POSTGRES_HOST="localhost"
export POSTGRES_PORT="19433"
export POSTGRES_BIND="127.0.0.1"
export DOCKER_POSTGRES_HOST="postgres"
export DOCKER_POSTGRES_PORT="15432"
export POSTGRES_SSLMODE="disable"
export POSTGRES_DATA_DIR="$APP_ROOT/.local/postgres"
export QDRANT_IMAGE="qdrant/qdrant:v1.9.3"
export QDRANT_HOST="localhost"
export QDRANT_PORT="19334"
export QDRANT_BIND="127.0.0.1"
export DOCKER_QDRANT_HOST="qdrant"
export DOCKER_QDRANT_PORT="16333"
export QDRANT_COLLECTION="legal_chunks"
export QDRANT_STORAGE_DIR="$APP_ROOT/.local/qdrant"
export OPENAI_API_KEY="${OPENAI_API_KEY:-replace-with-openai-key}"
export OPENAI_EMBEDDINGS_MODEL="text-embedding-3-small"
export OPENAI_CHAT_MODEL="gpt-4.1-mini"
export STORAGE_ROOT_DIR="/app/data/uploads"
export DOCKER_STORAGE_ROOT_DIR="/app/data/uploads"
export UPLOADS_DATA_DIR="$APP_ROOT/.local/uploads"
export INGEST_DEFAULT_SEGMENTER="free_text"
export INGEST_CHUNK_SIZE="800"
export INGEST_CHUNK_OVERLAP="100"
export GUARD_PROMPT_PATH="config/prompts/guard.yaml"
export TONE_DEFAULT_PROMPT_PATH="config/prompts/tone_default.yaml"
export TONE_ACADEMIC_PROMPT_PATH="config/prompts/tone_academic.yaml"
export TONE_PROCEDURE_PROMPT_PATH="config/prompts/tone_procedure.yaml"
export VECTOR_REPAIR_ENABLED="true"
export VECTOR_REPAIR_INTERVAL="30s"
export VECTOR_REPAIR_MAX_TASKS_PER_PASS="20"
export CORS_ALLOWED_ORIGINS="http://localhost:19080,http://127.0.0.1:19080"
export PUBLIC_BASE_URL="http://localhost:19080"

# web container
export DOMAIN="localhost"
export HTTP_PORT="19080"
export HTTPS_PORT="19443"
export HTTP_BIND="127.0.0.1"
export HTTPS_BIND="127.0.0.1"
export LETSENCRYPT_DIR="$APP_ROOT/.local/letsencrypt"
export CERTBOT_WEBROOT="$APP_ROOT/.local/certbot/www"
export ENABLE_SSL="0"
export FRONTEND_DEV_PORT="15175"
export FRONTEND_USE_POLLING="true"

# Browser-public frontend value. Local dev serves Vite on HTTP_PORT and proxies API calls to the api container.
export VITE_API_BASE_URL="http://localhost:19080"
